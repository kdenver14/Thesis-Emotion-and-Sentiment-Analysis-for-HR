generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id               String            @id @default(cuid())
    name             String?
    email            String?           @unique
    emailVerified    DateTime?
    image            String?
    password         String
    role             String            @default("STAFF")
    createdAt        DateTime?
    accounts         Account[]
    sessions         Session[]
    employees        Employee[]
    analysisSessions AnalysisSession[]
    trustedDevices   TrustedDevice[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime
    // Failed-attempt counter for short numeric step-up codes (pwchange).
    // Link tokens (verify/reset) never read it. NextAuth PrismaAdapter only
    // touches identifier/token/expires, so this additive column is inert there.
    attempts   Int      @default(0)

    @@unique([identifier, token])
}

// "Remember me" devices that may skip the emailed login code. The cookie
// holds only a random secret; its SHA-256 hash is stored here and bound to
// userId + expiry so the cookie alone is not authoritative and a leaked DB
// row is not a usable credential. Cascade-deleted with the user; bulk-revoked
// on password change / reset.
model TrustedDevice {
    id         String   @id @default(cuid())
    userId     String
    tokenHash  String   @unique
    expires    DateTime
    createdAt  DateTime @default(now())
    lastUsedAt DateTime @default(now())
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Employee {
    id               String            @id @default(cuid())
    name             String
    email            String?
    department       String?
    role             String?
    phone            String?
    status           String            @default("Active")
    userId              String
    user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    analysisSessions    AnalysisSession[]
    sessionParticipants SessionParticipant[]
    createdAt           DateTime              @default(now())
    updatedAt           DateTime              @updatedAt
}

model AnalysisSession {
    id                   String                @id @default(cuid())
    userId               String?
    user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
    employeeId           String?
    employee             Employee?             @relation(fields: [employeeId], references: [id])
    employeeSpeakerId    String?
    interviewerName      String?
    title                String
    sessionType          String                @default("interview")
    sessionDate          DateTime              @default(now())
    videoKey             String                @unique
    avgEmotions          String                @default("[]")
    avgSentiments        String                @default("[]")
    topEmotion           String                @default("")
    topSentiment         String                @default("")
    summary              String                @default("")
    durationSecs         Float?
    status               String                @default("PROCESSING")
    errorMessage         String?
    createdAt            DateTime              @default(now())
    utterances           Utterance[]
    onboardingCandidate  OnboardingCandidate?
    participants         SessionParticipant[]
}

// Meeting sessions only: declared employee participants. `speakerLabel`
// is null at upload (no diarized labels yet) and bound post-inference to
// a detected speaker. Single-employee session types use
// AnalysisSession.employeeId / employeeSpeakerId instead and never touch
// this table.
model SessionParticipant {
    id           String          @id @default(cuid())
    sessionId    String
    session      AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    employeeId   String
    employee     Employee        @relation(fields: [employeeId], references: [id])
    speakerLabel String?
    createdAt    DateTime        @default(now())

    @@unique([sessionId, employeeId])
    @@unique([sessionId, speakerLabel])
}

model OnboardingCandidate {
    id        String          @id @default(cuid())
    sessionId String          @unique
    session   AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    name      String
    position  String?
    email     String?
    phone     String?
    // Set once the candidate is promoted to an Employee from the session
    // page. Bare id (no FK relation), mirroring AnalysisSession.employeeSpeakerId;
    // employees soft-delete so this never dangles in practice.
    promotedEmployeeId String?
    // Set when HR marks the candidate as rejected. The interview session is
    // auto-deleted REJECTED_CANDIDATE_RETENTION_MONTHS after this timestamp.
    rejectedAt DateTime?
    createdAt DateTime        @default(now())
}

model Utterance {
    id         String          @id @default(cuid())
    sessionId  String
    session    AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    startTime  Float
    endTime    Float
    text       String
    speaker    String?
    emotions   String
    sentiments String
}

// Append-only admin action trail. No FK relations: actor and target are
// snapshotted by id + name at write time so a record outlives the user it
// references (compliance: logs must survive subject deletion). Mirrors the
// bare-id convention of AnalysisSession.employeeSpeakerId /
// OnboardingCandidate.promotedEmployeeId.
model AuditLog {
    id         String   @id @default(cuid())
    actorId    String
    actorName  String
    action     String
    targetType String
    targetId   String
    targetName String?
    createdAt  DateTime @default(now())

    @@index([createdAt])
}
