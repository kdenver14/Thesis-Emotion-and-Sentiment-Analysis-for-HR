# iCloud skips names ending in .nosync: Next's build output (distDir) and the
# Python venv (venv is a symlink to venv.nosync, so no trailing slash there).
*.nosync

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Python
__pycache__/
*.pyc
*.pyo
# venv* also covers iCloud copies such as "venv 2"
venv*
.venv/

# Environment variables
.env
.env.local
.env.*.local

# Large model files (exceed GitHub 100MB limit)
model_normalized/model.pth

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/



.claude/
CLAUDE.md

# Local inference job queue (downloaded videos)
ai-video-sentiment-model/deployment/jobs/
# Parity recordings: transcripts and features of your test videos
ai-video-sentiment-model/parity/runs/
# Personal run commands
/commands.txt

# ---- Private: keep out of the public repo ----
# Database copies: user emails and password hashes
**/prisma/db.sqlite*
*.bak
# Alpha/beta forms and results: testers' and respondents' names
tests/
alpha-test-results.docx
beta-test-results.docx
# Thesis working files (every top-level PDF and Word file)
/*.pdf
/*.docx
# These show the live server address
RUNNING.md
user-manual.docx
# Launch-video renders and stray files
brag-output/
Screenshot *.png
.impeccable/
